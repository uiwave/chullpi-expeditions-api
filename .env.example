# Copia este archivo a .env para uso local: cp .env.example .env
# En Coolify, define estas variables en la UI del recurso.

APP_PORT=8080
SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=api_db
DB_USER=api_user
DB_PASS=cambieme-por-una-clave-segura

# JWT: clave de firma HS256. Genera una con: openssl rand -base64 48
JWT_SECRET=cambieme-por-una-clave-de-al-menos-32-bytes
JWT_EXPIRATION_MINUTES=60

# OAuth2 Google (Google Cloud Console > APIs & Services > Credentials)
CLIENT_ID=tu-client-id-de-google.apps.googleusercontent.com
CLIENT_SECRET=tu-client-secret

# CORS: origen del front Angular
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Usuario administrador inicial (se crea solo si no existe)
ADMIN_EMAIL=admin@chullpi.com
ADMIN_PASSWORD=Admin123!
